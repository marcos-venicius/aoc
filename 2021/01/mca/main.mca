#!/usr/local/bin/mca

const str = import('string')
const io  = import('io')

const file = './input.txt'

const data = map(filter(str.split(io.read_entire_file(file), '\n'), \(line) -> line != ''), as_int)

part_one = 0

for i : [1, len(data)] {
  if data[i] > data[i - 1] part_one += 1
}

println('P1:', part_one)

part_two = 0

for i : len(data) - 3 {
  const m = data[i + 1] + data[i + 2]
  const a = data[i] + m
  const b = m + data[i + 3]
  if b > a part_two += 1
}

println('P2:', part_two)

