#!/usr/local/bin/mca

const io  = import('io')
const str = import('string')

const FILE = './input.txt'

const lines = str.split(io.read_entire_file(FILE), '\n')

data = [0]

for _, line : lines if (line == '') append(data, 0) else data[-1] += as_int(line)

data = sort(data, \(a, b) -> b - a)

println('P1:', data[0])
println('P2:', sum(data[0:3]))

